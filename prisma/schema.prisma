// Esquema de base de datos — Plataforma ADACV
//
// Modela la jerarquía Temporada → Jornada → Competición → Resultado, con
// Binomio (Guía + Perro + Club) como entidad de primer nivel, un motor de
// reglas configurable por Temporada/Modalidad (ReglaModalidad, en vez de
// constantes fijas en el código) y Clasificación como concepto separado de
// Resultado, tal y como exige el PRD.
//
// Ver /docs/analisis-adacv.md (o el documento "Análisis previo" del
// proyecto de Claude) para el razonamiento completo detrás de estas
// decisiones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enumerados
// ---------------------------------------------------------------------------

enum Rol {
  ADMIN
  SECRETARIA
  EDITOR
}

enum NivelCompeticion {
  NIVEL_II
  NIVEL_III
  // Categoría única para las tallas que no se dividen en grado (Mini 1,
  // Mini 2, Media: tienen tan pocos ejemplares que compiten todos juntos).
  // Solo Maxi y Large usan NIVEL_II/NIVEL_III de verdad.
  SIN_GRADO
  PERFORMANCE
}

// Las 5 alturas oficiales del reglamento. La agrupación en 4 categorías
// (Mini = MINI1+MINI2, Media, Maxi, Large) se calcula en código
// (ver src/lib/rules/categorias.ts) en vez de duplicarse como dato.
enum Talla {
  MINI1
  MINI2
  MEDIA
  MAXI
  LARGE
}

enum SexoPerro {
  MACHO
  HEMBRA
}

// Agrupación de Talla a efectos de CLASIFICACIÓN (el reglamento junta
// Mini 1 + Mini 2 en una sola categoría "Mini"). Los obstáculos y la
// altura de salto siguen usando las 5 alturas de `Talla`; solo la
// clasificación de temporada usa esta agrupación de 4.
enum CategoriaTalla {
  MINI
  MEDIA
  MAXI
  LARGE
}

enum Modalidad {
  AGILITY_STANDARD
  JUMPING
  JUMPING_RELEVOS
  KO
  STEEPLECHASE
  DEDALO
}

enum EstadoJornada {
  BORRADOR
  PUBLICADA
}

enum EstadoClasificacion {
  PENDIENTE
  REVISADA
  PUBLICADA
  BLOQUEADA
}

enum Calificacion {
  EXCELENTE
  MUY_BUENO
  BUENO
  SUFICIENTE
  NO_CALIFICADO
  ELIMINADO
}

// ---------------------------------------------------------------------------
// Usuarios / backoffice
// ---------------------------------------------------------------------------

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  rol          Rol      @default(SECRETARIA)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// Temporadas y motor de reglas configurable
// ---------------------------------------------------------------------------

model Temporada {
  id             String   @id @default(cuid())
  nombre         String   @unique // ej. "2025/2026"
  fechaInicio    DateTime
  fechaFin       DateTime
  // Número de jornadas planificadas para la temporada, decidido al crearla.
  // Al crear la temporada se generan automáticamente esas N jornadas vacías
  // (Jornada 1..N) para que secretaría solo tenga que elegir una y rellenar
  // sus datos, en vez de crearlas una a una desde cero. Nullable porque las
  // temporadas antiguas (creadas antes de esta función, p. ej. por el script
  // de seed) no tienen por qué tener un número planificado.
  numeroJornadas Int?
  activa         Boolean  @default(false)
  createdAt      DateTime @default(now())

  jornadas               Jornada[]
  reglas                 ReglaModalidad[]
  clasificaciones        ClasificacionTemporada[]
  binomiosTemporada      BinomioTemporada[]

  @@map("temporadas")
}

// Parámetros del motor de penalizaciones por Temporada + Modalidad.
// Sustituye las constantes fijas (PenaltyPerFault = 5.0, etc.) del
// proyecto de referencia AgilityScore: aquí son datos, no código, y
// pueden cambiar de una temporada a otra sin tocar el motor de reglas.
model ReglaModalidad {
  id          String    @id @default(cuid())
  temporadaId String
  temporada   Temporada @relation(fields: [temporadaId], references: [id], onDelete: Cascade)
  modalidad   Modalidad

  // Penalizaciones base (puntos)
  penalizacionFalta      Float @default(5)
  penalizacionRehuse     Float @default(5)
  penalizacionPorSegundo Float @default(1)
  penalizacionEliminacion Float @default(50)

  // Un binomio inscrito que no se presenta a su manga recibe esta
  // penalización fija (en vez de la de eliminación normal) y SÍ cuenta
  // para la clasificación de temporada, como una prueba disputada más.
  penalizacionNoPresentado Float @default(75)

  // Causa de eliminación por acumulación de rehúses (reglamento: al 3er
  // rehúse se elimina, con independencia del número de faltas).
  rehusesParaEliminar Int @default(3)

  // Factor TRM = TRS × factor, acotado entre estos dos límites.
  trmFactorMin Float @default(1.5)
  trmFactorMax Float @default(2.0)

  // Bandas de calificación por manga, en función de la penalización total.
  // Array de { nombre: Calificacion, max: number | null } evaluado en orden;
  // "max: null" es la banda catch-all (No Calificado). Se guarda como JSON
  // para que cada temporada pueda ajustar los cortes sin migrar el esquema.
  // Ejemplo (valores oficiales agosto 2025):
  // [
  //   { "nombre": "EXCELENTE",     "max": 5   },
  //   { "nombre": "MUY_BUENO",     "max": 10  },
  //   { "nombre": "BUENO",         "max": 15  },
  //   { "nombre": "SUFICIENTE",    "max": 25  },
  //   { "nombre": "NO_CALIFICADO", "max": null}
  // ]
  bandasCalificacion Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([temporadaId, modalidad])
  @@map("reglas_modalidad")
}

// ---------------------------------------------------------------------------
// Clubes, jueces, guías, perros, binomios
// ---------------------------------------------------------------------------

model Club {
  id        String   @id @default(cuid())
  nombre    String
  poblacion String?
  provincia String?
  logoUrl   String?
  web       String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  guias     Guia[]
  binomios  Binomio[]
  jornadas  Jornada[]

  @@map("clubes")
}

model Juez {
  id       String  @id @default(cuid())
  nombre   String
  licencia String?
  fotoUrl  String?
  activo   Boolean @default(true)

  jornadas     Jornada[]
  competiciones Competicion[]

  @@map("jueces")
}

model Guia {
  id        String  @id @default(cuid())
  nombre    String
  apellidos String
  licencia  String?

  // Datos personales de la ficha/tarjeta deportiva en papel. Nullable porque
  // los guías dados de alta antes de recoger esta información no la tienen.
  email           String?
  telefono        String?
  dni             String? // DNI / NIE / pasaporte
  fechaNacimiento DateTime?
  domicilio       String?
  poblacion       String?
  provincia       String?
  codigoPostal    String?

  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id])

  binomios Binomio[]

  @@map("guias")
}

model Perro {
  id     String  @id @default(cuid())
  nombre String
  raza   String?

  // Datos de la ficha/tarjeta deportiva en papel. Nullable porque los perros
  // dados de alta antes de recoger esta información no la tienen.
  microchip String?
  sexo      SexoPerro?

  // Nivel de competición ACTUAL del perro, editado a mano por secretaría
  // (no por temporada: a diferencia de BinomioTemporada.nivel, más abajo,
  // este es el único campo que la app usa de verdad hoy para saber a qué
  // nivel se inscribe/sortea un binomio, porque BinomioTemporada nunca
  // llegó a tener una pantalla desde la que rellenarlo). NIVEL_II/NIVEL_III
  // solo tienen sentido si `talla` es MAXI o LARGE; el resto de tallas
  // llevan SIN_GRADO (o PERFORMANCE si compite en ese programa). Nullable
  // hasta que secretaría se lo asigna.
  nivel NivelCompeticion?

  tallaCm         Float?
  talla           Talla
  fechaNacimiento DateTime?

  binomios Binomio[]

  @@map("perros")
}

// Identidad estable Guía + Perro + Club a lo largo de temporadas.
model Binomio {
  id       String  @id @default(cuid())
  guiaId   String
  guia     Guia    @relation(fields: [guiaId], references: [id])
  perroId  String
  perro    Perro   @relation(fields: [perroId], references: [id])
  clubId   String?
  club     Club?   @relation(fields: [clubId], references: [id])
  activo   Boolean @default(true)

  temporadas               BinomioTemporada[]
  resultados               Resultado[]
  clasificaciones          ClasificacionEntrada[]
  clasificacionesJornada   ClasificacionJornadaEntrada[]
  inscripciones            Inscripcion[]

  @@unique([guiaId, perroId])
  @@map("binomios")
}

// Nivel y puntos acumulados de un binomio EN una temporada concreta
// (el nivel puede subir/bajar de una temporada a otra por ascensos/descensos).
model BinomioTemporada {
  id                  String           @id @default(cuid())
  binomioId           String
  binomio             Binomio          @relation(fields: [binomioId], references: [id])
  temporadaId         String
  temporada           Temporada        @relation(fields: [temporadaId], references: [id])
  nivel               NivelCompeticion
  pruebasDisputadas   Int              @default(0)
  puntosAcumulados    Float            @default(0)

  @@unique([binomioId, temporadaId])
  @@map("binomios_temporada")
}

// ---------------------------------------------------------------------------
// Jornadas y competiciones
// ---------------------------------------------------------------------------

model Jornada {
  id          String        @id @default(cuid())
  temporadaId String
  temporada   Temporada     @relation(fields: [temporadaId], references: [id])
  clubId      String?
  club        Club?         @relation(fields: [clubId], references: [id])
  juezId      String?
  juez        Juez?         @relation(fields: [juezId], references: [id])

  // Posición de esta jornada dentro del calendario planificado de la
  // temporada (1, 2, 3...). Se asigna al generar los huecos de jornada al
  // crear la temporada; nullable porque una jornada añadida a mano fuera
  // del plan original (o una jornada antigua de antes de esta función) no
  // tiene por qué tener un número. Postgres permite varios NULL bajo un
  // índice único, así que conviven sin problema con las numeradas.
  numero      Int?

  nombre      String
  fecha       DateTime
  lugar       String?
  descripcion String?
  estado      EstadoJornada @default(BORRADOR)

  // false mientras la jornada es solo un "hueco" generado automáticamente
  // (fecha/lugar todavía son un valor provisional); pasa a true en cuanto
  // secretaría guarda sus datos reales (ver actualizarDatosJornadaAction).
  // Por defecto true, para que las jornadas creadas a mano (o antes de esta
  // función) no aparezcan como "pendientes de configurar" sin motivo.
  configurada Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competiciones          Competicion[]
  galerias               Galeria[]
  inscripciones          Inscripcion[]
  clasificacionesJornada ClasificacionJornada[]

  @@unique([temporadaId, numero])
  @@map("jornadas")
}

// Una "manga" concreta: modalidad + nivel + talla dentro de una jornada.
model Competicion {
  id         String           @id @default(cuid())
  jornadaId  String
  jornada    Jornada          @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
  modalidad  Modalidad
  nivel      NivelCompeticion
  talla      Talla
  manga      Int              @default(1)
  juezId     String?
  juez       Juez?            @relation(fields: [juezId], references: [id])

  // Parámetros para calcular TRS/TRM (ver src/lib/rules/tiempo.ts).
  // TRS = longitudM / velocidadMs + tiempoParadaMesaS
  // TRM = TRS × trmFactor (acotado por ReglaModalidad.trmFactorMin/Max)
  longitudM         Float?
  velocidadMs       Float?
  tiempoParadaMesaS Float   @default(0)
  trmFactor         Float   @default(1.5)

  createdAt DateTime @default(now())

  resultados Resultado[]

  @@map("competiciones")
}

// Un binomio apuntado (inscrito) a una jornada concreta. Lo gestiona
// secretaría/la mesa desde el backoffice — los guías no se apuntan ellos
// mismos. Sirve de base para el sorteo del orden de salida.
model Inscripcion {
  id        String   @id @default(cuid())
  jornadaId String
  jornada   Jornada  @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
  binomioId String
  binomio   Binomio  @relation(fields: [binomioId], references: [id])
  createdAt DateTime @default(now())

  @@unique([jornadaId, binomioId])
  @@map("inscripciones")
}

// ---------------------------------------------------------------------------
// Resultados (por manga) y Clasificación (por temporada) — conceptos
// deliberadamente separados, tal como exige el PRD.
// ---------------------------------------------------------------------------

model Resultado {
  id            String       @id @default(cuid())
  competicionId String
  competicion   Competicion  @relation(fields: [competicionId], references: [id], onDelete: Cascade)
  binomioId     String
  binomio       Binomio      @relation(fields: [binomioId], references: [id])

  dorsal   Int?
  tiempoS  Float?
  faltas   Int     @default(0)
  rehuses  Int     @default(0)
  eliminado         Boolean @default(false)
  motivoEliminacion String?
  // Un no presentado también se guarda como `eliminado: true` (para que
  // toda la lógica que ya filtra por eliminado lo siga tratando igual),
  // pero con este campo aparte para poder mostrarlo en la interfaz como
  // "No presentado" en vez de una eliminación normal.
  noPresentado      Boolean @default(false)

  // Campos calculados por el motor de reglas (src/lib/rules/engine.ts) y
  // almacenados para lectura rápida; siempre recalculables a partir de los
  // datos crudos de arriba + la ReglaModalidad vigente.
  penalizacionTiempo Float?
  penalizacionTotal  Float?
  calificacion       Calificacion?

  publicado Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competicionId, binomioId])
  @@map("resultados")
}

// Estado de la clasificación de una Temporada+Nivel+Talla — flujo propio
// (pendiente → revisada → publicada, o bloqueada) independiente de la
// publicación de resultados de cada jornada.
model ClasificacionTemporada {
  id          String              @id @default(cuid())
  temporadaId String
  temporada   Temporada           @relation(fields: [temporadaId], references: [id])
  nivel       NivelCompeticion
  categoria   CategoriaTalla
  estado      EstadoClasificacion @default(PENDIENTE)
  actualizadaEn DateTime          @default(now())
  publicadaEn   DateTime?

  entradas ClasificacionEntrada[]

  @@unique([temporadaId, nivel, categoria])
  @@map("clasificaciones_temporada")
}

model ClasificacionEntrada {
  id                       String                 @id @default(cuid())
  clasificacionTemporadaId String
  clasificacionTemporada   ClasificacionTemporada @relation(fields: [clasificacionTemporadaId], references: [id], onDelete: Cascade)
  binomioId                String
  binomio                  Binomio                @relation(fields: [binomioId], references: [id])

  posicion          Int
  puntos            Float
  pruebasDisputadas Int
  tendencia         Int    @default(0) // -1 baja, 0 igual, 1 sube (vs. cálculo anterior)

  @@unique([clasificacionTemporadaId, binomioId])
  @@map("clasificacion_entradas")
}

// Clasificación de UNA jornada concreta (además de la de temporada, que
// acumula todas las jornadas): cada club da trofeo a los tres primeros de
// cada jornada, tanto de cada modalidad por separado (Agility Standard,
// Jumping...) como de la general de esa jornada (todas las modalidades de
// ese nivel/categoría disputadas ese día, sumadas). `agrupacion` guarda el
// código de Modalidad ("AGILITY_STANDARD", "JUMPING"...) para las filas por
// modalidad, o el valor especial "GENERAL" para la combinada — se usa un
// String en vez del enum Modalidad para poder representar "GENERAL" sin
// forzar un valor falso en ese enum (que representa disciplinas reales).
model ClasificacionJornada {
  id          String              @id @default(cuid())
  jornadaId   String
  jornada     Jornada             @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
  nivel       NivelCompeticion
  categoria   CategoriaTalla
  agrupacion  String
  estado      EstadoClasificacion @default(PENDIENTE)
  actualizadaEn DateTime          @default(now())
  publicadaEn   DateTime?

  entradas ClasificacionJornadaEntrada[]

  @@unique([jornadaId, nivel, categoria, agrupacion])
  @@map("clasificaciones_jornada")
}

model ClasificacionJornadaEntrada {
  id                     String               @id @default(cuid())
  clasificacionJornadaId String
  clasificacionJornada   ClasificacionJornada @relation(fields: [clasificacionJornadaId], references: [id], onDelete: Cascade)
  binomioId              String
  binomio                Binomio              @relation(fields: [binomioId], references: [id])

  posicion Int
  puntos   Float // penalización acumulada ese día en esa agrupación (sin el bono)
  // Bonificación de puntos por podio EN LA GENERAL de la jornada, que se
  // resta de la clasificación de temporada (-8/-6/-2 para 1º/2º/3º según
  // indicó David; 0 en el resto de filas y siempre 0 en las filas por
  // modalidad, que son solo para trofeo, no dan bonificación).
  bonus    Float @default(0)

  @@unique([clasificacionJornadaId, binomioId])
  @@map("clasificacion_jornada_entradas")
}

// ---------------------------------------------------------------------------
// Contenido: galerías, noticias, patrocinadores, documentos
// ---------------------------------------------------------------------------

model Galeria {
  id          String   @id @default(cuid())
  jornadaId   String?
  jornada     Jornada? @relation(fields: [jornadaId], references: [id])
  titulo      String
  fecha       DateTime
  descripcion String?
  createdAt   DateTime @default(now())

  fotos Foto[]

  @@map("galerias")
}

model Foto {
  id        String   @id @default(cuid())
  galeriaId String
  galeria   Galeria  @relation(fields: [galeriaId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  orden     Int      @default(0)

  @@map("fotos")
}

model Noticia {
  id          String    @id @default(cuid())
  titulo      String
  slug        String    @unique
  resumen     String
  contenido   String
  portadaUrl  String?
  autor       String?
  publicadoEn DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@map("noticias")
}

model Sponsor {
  id      String  @id @default(cuid())
  nombre  String
  logoUrl String
  url     String?
  nivel   String  @default("Colaborador") // ej. Oro / Plata / Colaborador
  activo  Boolean @default(true)
  orden   Int     @default(0)

  @@map("sponsors")
}

model Documento {
  id                String   @id @default(cuid())
  titulo            String
  categoria         String // ej. "reglamento", "formulario", "acta"
  url               String
  fechaPublicacion  DateTime @default(now())

  @@map("documentos")
}
