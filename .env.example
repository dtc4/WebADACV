# Copia este archivo a ".env" y rellena los valores reales.
# No subas nunca el archivo ".env" (ya está en .gitignore).

# Cadena de conexión a PostgreSQL.
# Ejemplos:
#  - Local:    postgresql://usuario:password@localhost:5432/webadacv
#  - Supabase: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
#  - Neon:     postgresql://usuario:password@ep-xxxx.neon.tech/webadacv?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/webadacv"

# Secreto usado para firmar las cookies de sesión del backoffice.
# Genera uno nuevo con: openssl rand -base64 32
SESSION_SECRET="cambia-este-valor-por-uno-aleatorio-y-largo"

# URL pública del sitio (usada en metadatos / enlaces absolutos).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
